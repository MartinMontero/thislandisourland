[{"t":29,"text":"Bigger in Texas including the shock."},{"t":33,"text":"And this"},{"t":39,"text":"shocked"},{"t":40,"text":"the world"},{"t":42,"text":"tonight."},{"t":46,"text":"With a Texas chip on our shoulder."},{"t":51,"text":"It's possible"},{"t":62,"text":"-- It never"},{"t":62,"text":"-- bothered me"},{"t":64,"text":"that they doubted me."},{"t":68,"text":"It bothered me that they doubted us."},{"t":76,"text":"Hundreds"},{"t":77,"text":"and millions on attack ads"},{"t":80,"text":"written off over"},{"t":82,"text":"and over"},{"t":84,"text":"again."},{"t":86,"text":"But Texas,"},{"t":88,"text":"my faith in you never wavered."},{"t":97,"text":"I have spoken to Governor Abbott."},{"t":104,"text":"all to congratulate me."},{"t":111,"text":"-- He extended a generous offer"},{"t":111,"text":"-- to assist"},{"t":115,"text":"with the transition."},{"t":120,"text":"-- I want to thank"},{"t":120,"text":"-- him"},{"t":122,"text":"-- and"},{"t":122,"text":"-- his family"},{"t":123,"text":"for their years"},{"t":124,"text":"of service to this great state."},{"t":135,"text":"And"},{"t":136,"text":"now"},{"t":137,"text":"For"},{"t":137,"text":"you humble"},{"t":139,"text":"and grateful."},{"t":147,"text":"All"},{"t":149,"text":"of the incredible"},{"t":151,"text":"grace"},{"t":152,"text":"and power"},{"t":154,"text":"of God."},{"t":156,"text":"And of taxes."},{"t":163,"text":"I"},{"t":164,"text":"am the daughter"},{"t":166,"text":"of the Rio Grande Valley."},{"t":191,"text":"Where the people embody the work ethic and values of our great state."},{"t":198,"text":"-- Where no one"},{"t":198,"text":"-- would have imagined"},{"t":199,"text":"that one day,"},{"t":201,"text":"a little girl from the RGB."},{"t":207,"text":"-- Would stand"},{"t":207,"text":"-- before you here"},{"t":210,"text":"as the next"},{"t":211,"text":"governor"},{"t":212,"text":"-- of the"},{"t":212,"text":"-- greatest state."},{"t":225,"text":"But God had a plan."},{"t":227,"text":"-- And"},{"t":227,"text":"-- the people of Texas"},{"t":230,"text":"had a plan too."},{"t":234,"text":"It was a plan I did not know."},{"t":238,"text":"I never set out to be a politician."},{"t":242,"text":"I am a mom."},{"t":246,"text":"I am a mom"},{"t":247,"text":"who loves her children,"},{"t":250,"text":"who believes"},{"t":252,"text":"in their teachers."},{"t":259,"text":"And who"},{"t":259,"text":"-- believes in"},{"t":259,"text":"-- Texas public."},{"t":287,"text":"And when I saw my child's school under threat,"},{"t":290,"text":"I did what any mom would do."},{"t":292,"text":"I"},{"t":293,"text":"fought"},{"t":294,"text":"back."},{"t":298,"text":"I ran for the school board because I wanted my child and every Texas child"},{"t":304,"text":"to have the opportunity"},{"t":306,"text":"to succeed."},{"t":309,"text":"From the school board to the House of Representatives."},{"t":315,"text":"And now,"},{"t":317,"text":"with your extraordinary faith."},{"t":320,"text":"And the trust of the people of Texas"},{"t":324,"text":"to"},{"t":324,"text":"the"},{"t":325,"text":"governor's."},{"t":343,"text":"Here,"},{"t":344,"text":"only here,"},{"t":344,"text":"where no matter where you come from,"},{"t":347,"text":"no matter how humble your beginnings,"},{"t":350,"text":"your life"},{"t":351,"text":"-- can"},{"t":351,"text":"-- be bigger"},{"t":353,"text":"than your dreams."},{"t":358,"text":"When we started this campaign a little over a year ago,"},{"t":362,"text":"-- I"},{"t":362,"text":"-- asked a simple"},{"t":365,"text":"question."},{"t":366,"text":"-- Is Texas a state that is by and for the"},{"t":366,"text":"-- people?"},{"t":376,"text":"-- Or is"},{"t":376,"text":"-- this the billionaires' world and we just live here?"},{"t":384,"text":"Does Texas belong to the parents and their children?"},{"t":390,"text":"Or the billionaires trying to dismantle."},{"t":397,"text":"Does Texas belong to the farmers"},{"t":400,"text":"and ranchers who"},{"t":410,"text":"Corporations trying to buy it up."},{"t":415,"text":"Does taxes belong to the working families who pay their"},{"t":423,"text":"Right."},{"t":425,"text":"-- Or the wealthy and well-connected who play by"},{"t":425,"text":"-- different"},{"t":428,"text":"rules."},{"t":432,"text":"Does Texas"},{"t":434,"text":"belong to the people who rise before the sun?"},{"t":438,"text":"Who worked two jobs."},{"t":441,"text":"Help our homes to keep our hospitals running."},{"t":446,"text":"-- they've got into small businesses and"},{"t":446,"text":"-- big"},{"t":449,"text":"dreams."},{"t":454,"text":"-- Or does it belong to"},{"t":454,"text":"-- the people who write the biggest check to politicians in Austin?"},{"t":466,"text":"Tonight,"},{"t":466,"text":"Texas,"},{"t":467,"text":"we answered."},{"t":472,"text":"And we did not whisper."},{"t":478,"text":"Every billion"},{"t":479,"text":"I"},{"t":489,"text":"Belongs to us."},{"t":494,"text":"The question we answered in McAllen"},{"t":496,"text":"and Corpus Christi."},{"t":503,"text":"there."},{"t":506,"text":"From the neighbor"},{"t":507,"text":"Austin to the wide open skies of West Texas."},{"t":512,"text":"Out to Big Ben."},{"t":518,"text":"-- in our big cities where they"},{"t":518,"text":"-- tried to silence your voice with"},{"t":522,"text":"gerrymandered maps."},{"t":526,"text":"And close polling sites only to see turnout like never."},{"t":535,"text":"-- in small towns where people have been told their vote"},{"t":535,"text":"-- was already spoken for."},{"t":542,"text":"-- We entered in communities that politicians visit every 4 years"},{"t":542,"text":"-- to ask"},{"t":547,"text":"-- for"},{"t":547,"text":"-- your vote,"},{"t":549,"text":"only to forget about you as soon as they get to Austin."},{"t":553,"text":"We answered in places that have been overlooked,"},{"t":557,"text":"underestimated and left behind for far"},{"t":560,"text":"too"},{"t":561,"text":"long."},{"t":563,"text":"And we answered across party"},{"t":566,"text":"lines."},{"t":571,"text":"It was always about whether the people of"},{"t":574,"text":"-- Texas ought to"},{"t":574,"text":"-- have a government that belongs to"},{"t":578,"text":"them."},{"t":582,"text":"Highest bidder,"},{"t":583,"text":"not the biggest donor,"},{"t":585,"text":"not the most powerful lobbyist,"},{"t":587,"text":"you."},{"t":591,"text":"-- And"},{"t":591,"text":"-- I wanna say something"},{"t":593,"text":"to the powerful people"},{"t":594,"text":"who have gotten very comfortable"},{"t":597,"text":"running this state."},{"t":607,"text":"have delivered a mandate for change."},{"t":610,"text":"is"},{"t":625,"text":"-- With the politics of"},{"t":625,"text":"-- courage,"},{"t":627,"text":"not convenience."},{"t":629,"text":"Progress will not be halted by partisanship,"},{"t":632,"text":"-- and"},{"t":632,"text":"-- Texas will bow down to no one."},{"t":641,"text":"Treating our public schools like they are for sale are over."},{"t":651,"text":"Our tax dollars like your personal piggy bank are over."},{"t":657,"text":"Days of writing one set of rules for working people"},{"t":660,"text":"-- and another for the wealthy"},{"t":660,"text":"-- and well-to do are over."},{"t":668,"text":"of telling Texans to settle"},{"t":670,"text":"-- for"},{"t":670,"text":"-- less"},{"t":671,"text":"while only billionaires in boardrooms profit from the state we have all."},{"t":678,"text":"Those days are over."},{"t":686,"text":"-- By people with calloused"},{"t":686,"text":"-- hands and tired feet,"},{"t":690,"text":"-- by"},{"t":690,"text":"-- teachers"},{"t":691,"text":"and nurses."},{"t":694,"text":"By oil field workers and truck drivers."},{"t":698,"text":"By small business owners who put everything they had"},{"t":702,"text":"on the line."},{"t":704,"text":"-- By"},{"t":704,"text":"-- parents who sacrificed so their children could have"},{"t":707,"text":"a better"},{"t":708,"text":"life."},{"t":711,"text":"And those"},{"t":712,"text":"are the people who should come first in the state they"},{"t":716,"text":"built."},{"t":723,"text":"-- They have"},{"t":723,"text":"-- labored"},{"t":724,"text":"and maintained an American dream through a long,"},{"t":728,"text":"hard"},{"t":729,"text":"night."},{"t":731,"text":"My friends,"},{"t":732,"text":"it is morning now."},{"t":739,"text":"Tomorrow our transition."},{"t":763,"text":"I"},{"t":764,"text":"will take the oath of office,"},{"t":766,"text":"ready to lead"},{"t":767,"text":"a government"},{"t":769,"text":"by the people"},{"t":770,"text":"and for the people."},{"t":776,"text":"who donated the most."},{"t":779,"text":"-- Not for the people who know"},{"t":779,"text":"-- the right people."},{"t":783,"text":"But for every single Texan."},{"t":789,"text":"Office does not belong"},{"t":791,"text":"-- to"},{"t":791,"text":"-- me."},{"t":793,"text":"It does not belong"},{"t":794,"text":"to my party."},{"t":796,"text":"It belongs to you."},{"t":802,"text":"This is our taxes,"},{"t":803,"text":"-- this is"},{"t":803,"text":"-- our"},{"t":804,"text":"government,"},{"t":805,"text":"and this is our"},{"t":806,"text":"one"},{"t":807,"text":"fight."},{"t":809,"text":"And tonight"},{"t":810,"text":"we won."},{"t":823,"text":"Clear,"},{"t":824,"text":"-- we did not end one era of single party rule"},{"t":824,"text":"-- just to usher in"},{"t":830,"text":"another."},{"t":832,"text":"The same national pundits and political class"},{"t":835,"text":"who ignored and then misunderstood this campaign"},{"t":839,"text":"will declare"},{"t":840,"text":"this a victory"},{"t":842,"text":"for Democrats."},{"t":845,"text":"They continue to misunderstand."},{"t":848,"text":"This victory is so much"},{"t":850,"text":"bigger."},{"t":853,"text":"in taxes."},{"t":859,"text":"Victory for taxpayers who work too hard to see"},{"t":862,"text":"-- their money handed out to donors"},{"t":862,"text":"-- and special interests."},{"t":867,"text":"We will end"},{"t":868,"text":"the era of no-bid contracts."},{"t":876,"text":"and"},{"t":878,"text":"It is a victory for young people."},{"t":884,"text":"Across our state who possess unimaginable"},{"t":888,"text":"talents"},{"t":889,"text":"but have been left feeling so"},{"t":892,"text":"little"},{"t":893,"text":"hope."},{"t":895,"text":"You will never have to choose between the state you"},{"t":899,"text":"-- love"},{"t":899,"text":"-- and"},{"t":899,"text":"-- a"},{"t":899,"text":"-- job that will pay your worth."},{"t":905,"text":"have the economy that serves your ambitions,"},{"t":908,"text":"your dreams and your hard work."},{"t":911,"text":"A government on your side,"},{"t":913,"text":"and the hope"},{"t":914,"text":"you deserve."},{"t":919,"text":"The victory for teachers"},{"t":921,"text":"who will"},{"t":932,"text":"In case you have not heard,"},{"t":934,"text":"on day one,"},{"t":935,"text":"I will fire my."},{"t":950,"text":"Work tirelessly to repair"},{"t":953,"text":"the damage of the Texas voucher scam."},{"t":961,"text":"In which our schools are sold for parts."},{"t":967,"text":"A victory for the parents"},{"t":969,"text":"of Texas."},{"t":972,"text":"We are taking our children's education back from a government that has failed them."},{"t":982,"text":"They will not be taken out of our control."},{"t":985,"text":"They will not be shattered or suffocated."},{"t":992,"text":"Being a parent"},{"t":993,"text":"is hard"},{"t":995,"text":"enough."},{"t":996,"text":"Without carrying the burden"},{"t":998,"text":"of a government's failures."},{"t":1002,"text":"To the children"},{"t":1003,"text":"of Texas."},{"t":1006,"text":"-- Your schools will"},{"t":1006,"text":"-- not"},{"t":1007,"text":"close."},{"t":1011,"text":"-- You will be invested in and you will"},{"t":1011,"text":"-- grow up"},{"t":1014,"text":"-- in a Texas where you are lifted"},{"t":1014,"text":"-- up every single"},{"t":1019,"text":"-- day to"},{"t":1019,"text":"-- reach your God-given"},{"t":1022,"text":"potential."},{"t":1030,"text":"-- Tonight I make a solemn promise"},{"t":1030,"text":"-- to every"},{"t":1033,"text":"single"},{"t":1034,"text":"Texan."},{"t":1036,"text":"Whether you voted for me"},{"t":1038,"text":"or Greg Abbott or felt so betrayed"},{"t":1041,"text":"by a broken politics that you did not vote"},{"t":1044,"text":"at all."},{"t":1046,"text":"Whether you're a Democrat,"},{"t":1048,"text":"a Republican."},{"t":1050,"text":"Or neither."},{"t":1052,"text":"No matter where you live."},{"t":1054,"text":"No matter what your expectations of me are,"},{"t":1058,"text":"no matter how accustomed you've become"},{"t":1061,"text":"to corruption"},{"t":1063,"text":"and incompetence,"},{"t":1064,"text":"to experiencing government as something that is done to you."},{"t":1069,"text":"Not with you,"},{"t":1070,"text":"or for you,"},{"t":1072,"text":"or by you."},{"t":1073,"text":"Here's what Texas"},{"t":1075,"text":"said"},{"t":1076,"text":"today."},{"t":1077,"text":"Loud"},{"t":1078,"text":"and clear."},{"t":1082,"text":"Your government belongs to you."},{"t":1089,"text":"As your governor,"},{"t":1090,"text":"I will never forget it."},{"t":1093,"text":"There will be no special set of rules for the wealthy and well connected."},{"t":1098,"text":"No looking the other way when someone in my own party does wrong."},{"t":1103,"text":"No excuses for corruption"},{"t":1106,"text":"-- because it comes from someone who shares"},{"t":1106,"text":"-- my politics."},{"t":1111,"text":"Corruption does not become right when our side does it."},{"t":1117,"text":"Accountability does not stop at the doors of the governor's office,"},{"t":1121,"text":"it begins there."},{"t":1128,"text":"The trust you have placed in me tonight"},{"t":1131,"text":"is not a blank check."},{"t":1133,"text":"It is a sacred"},{"t":1134,"text":"responsibility,"},{"t":1136,"text":"and I intend to earn it every"},{"t":1138,"text":"single"},{"t":1139,"text":"day."},{"t":1145,"text":"There will be times when we disagree."},{"t":1148,"text":"But I promise you this,"},{"t":1150,"text":"I will always tell you"},{"t":1153,"text":"the truth."},{"t":1154,"text":"And nothing"},{"t":1155,"text":"but"},{"t":1156,"text":"the truth."},{"t":1160,"text":"I will serve you"},{"t":1162,"text":"and only"},{"t":1163,"text":"you."},{"t":1165,"text":"I will listen when you disagree."},{"t":1168,"text":"I will admit when I am wrong,"},{"t":1170,"text":"and I will never forget"},{"t":1172,"text":"who sent me here."},{"t":1179,"text":"The power"},{"t":1179,"text":"of this office does not belong to me,"},{"t":1182,"text":"it belongs to you."},{"t":1185,"text":"And as excited I am by the history we've made"},{"t":1190,"text":"tonight."},{"t":1193,"text":"-- I pray it does not compare"},{"t":1193,"text":"-- to the future we build"},{"t":1196,"text":"together."},{"t":1203,"text":"-- The nation will look at Texas and say"},{"t":1203,"text":"-- we"},{"t":1205,"text":"-- want"},{"t":1205,"text":"-- something far more important than an election."},{"t":1210,"text":"They will look"},{"t":1211,"text":"at Texas and say that faith in government has been"},{"t":1215,"text":"restored."},{"t":1221,"text":"-- At Texas and"},{"t":1221,"text":"-- see the power of a government that lifts every single person"},{"t":1227,"text":"up"},{"t":1228,"text":"and never"},{"t":1229,"text":"punches down."},{"t":1232,"text":"-- We will build a government more"},{"t":1232,"text":"-- honest,"},{"t":1235,"text":"more just,"},{"t":1236,"text":"and worthy of the people"},{"t":1238,"text":"Texas call home,"},{"t":1240,"text":"and we will never forget the simple"},{"t":1243,"text":"truth that brought us here tonight."},{"t":1246,"text":"Texas belongs"},{"t":1247,"text":"to the people"},{"t":1249,"text":"of Texas."},{"t":1254,"text":"No but think"},{"t":1255,"text":"of my grandmother,"},{"t":1257,"text":"Grandma Hinomosa."},{"t":1259,"text":"Who used to tell me."},{"t":1262,"text":"Note."},{"t":1265,"text":"Know your worth and fight to defend it."},{"t":1270,"text":"A lot of Latinas in Texas grew up hearing"},{"t":1273,"text":"those same words."},{"t":1276,"text":"From their own mothers."},{"t":1277,"text":"Their own abuelas."},{"t":1280,"text":"This year we live them"},{"t":1282,"text":"and we change"},{"t":1283,"text":"this state"},{"t":1284,"text":"and this win belongs to you"},{"t":1286,"text":"and to them."},{"t":1294,"text":"-- And I need to thank some people here now"},{"t":1294,"text":"-- who made this"},{"t":1297,"text":"-- all"},{"t":1297,"text":"-- possible."},{"t":1300,"text":"Pablo,"},{"t":1301,"text":"nobody has sacrificed more"},{"t":1303,"text":"than you."},{"t":1309,"text":"You have"},{"t":1315,"text":"You have been so supportive"},{"t":1317,"text":"and gracious."},{"t":1319,"text":"And I am so proud of you."},{"t":1322,"text":"Even though neither you or Mateo ever asked for this."},{"t":1329,"text":"My fight comes from my deep love for the both of you and my desire to make"},{"t":1334,"text":"this world"},{"t":1335,"text":"safer and better"},{"t":1337,"text":"for the both of you."},{"t":1345,"text":"You have been so understanding"},{"t":1347,"text":"and encouraging,"},{"t":1348,"text":"and I thank you both so much."},{"t":1351,"text":"To"},{"t":1352,"text":"my husband John,"},{"t":1358,"text":"-- Who I made promise to never run for"},{"t":1358,"text":"-- office."},{"t":1365,"text":"You have been the rock"},{"t":1367,"text":"who has held"},{"t":1368,"text":"it all down"},{"t":1369,"text":"and sacrificed and stood beside me in the hardest"},{"t":1373,"text":"fights."},{"t":1375,"text":"This is not possible"},{"t":1376,"text":"without you,"},{"t":1377,"text":"and I love you."},{"t":1386,"text":"-- To my sister"},{"t":1386,"text":"-- Sochi."},{"t":1393,"text":"You spent a year telling everyone who would listen that we would win."},{"t":1401,"text":"And with such certainty that it finally came true."},{"t":1409,"text":"I love you."},{"t":1411,"text":"You're the best sister"},{"t":1412,"text":"a sister could ask for."},{"t":1416,"text":"Mom and dad,"},{"t":1417,"text":"Cindy and Robert,"},{"t":1418,"text":"my brothers and sisters and my entire"},{"t":1422,"text":"family,"},{"t":1422,"text":"thank you."},{"t":1429,"text":"Everything I"},{"t":1431,"text":"-- This day is"},{"t":1431,"text":"-- because of you and I love all of you."},{"t":1439,"text":"To"},{"t":1439,"text":"our next United States Senator James Teller."},{"t":1450,"text":"-- For years"},{"t":1450,"text":"-- we believed there had to be a different and"},{"t":1453,"text":"better"},{"t":1454,"text":"way forward."},{"t":1456,"text":"It looks like we were right."},{"t":1462,"text":"Thank you"},{"t":1463,"text":"and congratulations my friend."},{"t":1471,"text":"-- To Amy"},{"t":1471,"text":"-- Friedman,"},{"t":1473,"text":"my."},{"t":1490,"text":"You are an angel sent down from heaven to run this campaign."},{"t":1495,"text":"You believed in me and you believed in Texas."},{"t":1499,"text":"I will never forget all that you gave,"},{"t":1502,"text":"all that you sacrificed to get us here."},{"t":1506,"text":"You led the best campaign team in the nation."},{"t":1512,"text":"A team that I hope gets some well-earned sleep"},{"t":1516,"text":"tonight."},{"t":1518,"text":"To the people who showed up early for me and often who"},{"t":1523,"text":"posted when I could still keep track of who was tagging me."},{"t":1528,"text":"Whether it was 10 times a day from Houston"},{"t":1530,"text":"-- or DMs spreading my message to"},{"t":1530,"text":"-- Texas newcomers."},{"t":1536,"text":"Who showed up at events when it was still only familiar faces."},{"t":1542,"text":"Who gave your labor and your love,"},{"t":1544,"text":"and you took a leap of faith."},{"t":1547,"text":"Thank you."},{"t":1554,"text":"And to my hometown Brownsville."},{"t":1572,"text":"becomes,"},{"t":1573,"text":"becomes"},{"t":1574,"text":"of"},{"t":1589,"text":"And God bless"},{"t":1590,"text":"Texas."}]